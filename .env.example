# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb://localhost:27017/colorado-ehr

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-256-bit-encryption-key-for-hipaa-compliance

# Colorado State Integration
COLORADO_MEDICAID_API_KEY=your-medicaid-api-key
COLORADO_IMMUNIZATION_REGISTRY_KEY=your-registry-key
COLORADO_PDMP_KEY=your-pdmp-api-key

# Billing Integration
CLEARINGHOUSE_API_KEY=your-clearinghouse-key
CLEARINGHOUSE_API_URL=https://api.clearinghouse.example.com

# Email/Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@colorado-ehr.gov
SMTP_PASS=your-smtp-password
